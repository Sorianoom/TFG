# los paquetes/outputs de NotebookLM, pero se CONSERVAN los CSV de resumen pequeños
# que están en la raíz de data/attack_analysis/.
data/attack_analysis/*/
data/notebooklm_attack_packages/
data/notebooklm_outputs/
data/samples/
data/balanced_50_50/
data/balanced_60_40/
data/balanced_70_30/

# Nota: se MANTIENEN versionados (no ignorados):
#   data/generalization/summaries/*.csv
#   data/attack_analysis/*summary*.csv  y  *label*.csv pequeños

# Excepciones: resúmenes pequeños del baseline ML citados en la memoria
# (apenas unos cientos de bytes; NO afecta a los volcados grandes results*.csv).
!data/attack_analysis/ml_baseline_results_active_families.csv
!data/attack_analysis/ml_baseline_results_no_spam.csv

