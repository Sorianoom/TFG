# Configuración del modo IA ON (NotebookLM) — EJEMPLO.
# Copia este archivo a "web/backend/.env" y rellena tus valores LOCALES.
# El archivo .env real NO se versiona (está en .gitignore). Nunca subas credenciales.

# Activar el modo IA ON (por defecto desactivado -> la web funciona en IA OFF).
NOTEBOOKLM_ENABLED=false

# Ruta LOCAL (fuera del repositorio) al archivo de credenciales/cookies que use
# notebooklm-py. No pongas el contenido aquí, solo la ruta en tu máquina.
NOTEBOOKLM_AUTH_PATH=

# Un cuaderno de NotebookLM POR ATAQUE (cada ataque tiene su propio cuaderno).
# Deja vacío el de un ataque para el que no tengas cuaderno: ese ataque usará IA OFF.
NOTEBOOKLM_DOS_ID=
NOTEBOOKLM_SCAN11_ID=
NOTEBOOKLM_SCAN44_ID=
NOTEBOOKLM_UDPSCAN_ID=
NOTEBOOKLM_NERISBOTNET_ID=
NOTEBOOKLM_SSHSCAN_ID=
NOTEBOOKLM_SPAM_ID=
